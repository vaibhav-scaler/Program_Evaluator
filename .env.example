# Copy to .env for local runs. Never commit the real .env file.
# On Railway, set these in the service's Variables tab instead.

# --- Server ---
PORT=8000
HOST=0.0.0.0
WORKERS=1

# --- Metabase (required for live lead lookup) ---
METABASE_URL=https://metabase.example.com
METABASE_USERNAME=
METABASE_PASSWORD=
# Optional alternatives to username and password:
METABASE_API_KEY=
METABASE_SESSION_TOKEN=
METABASE_PUBLIC_UUID=
# Defaults are applied when these are empty:
METABASE_CARD_ID=
METABASE_EMAIL_PARAM_ID=
METABASE_TIMEOUT=30

# --- Storage ---
# Optional: put the SQLite file on a persistent volume, for example /data/leads_store.db
DATABASE_PATH=

# --- Optional features ---
# Load every Metabase batch into the local database at start. Needs a lot of disk and time. Leave off on small plans.
ENABLE_BULK_INGEST=0
# Number of nearest past learners used for the refund figures
COHORT_MATCH_K=40
